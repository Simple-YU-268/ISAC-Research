 idx="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:schemeClr val="accent1" /></a:lnRef><a:fillRef idx="3" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:schemeClr val="accent1" /></a:fillRef><a:effectRef idx="2" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:schemeClr val="accent1" /></a:effectRef><a:fontRef idx="minor" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:schemeClr val="lt1" /></a:fontRef></p:style><p:txBody><a:bodyPr anchor="ctr" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr algn="ctr"><a:buNone /></a:pPr></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="55" name="TextBox 54"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{56CF20C2-091B-4AF8-9A81-E7E7844FA8A2}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="1347066" y="38379409" /><a:ext cx="12622464" cy="646331" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:spPr><p:txBody><a:bodyPr wrap="square" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:spAutoFit /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:r><a:rPr sz="3600" b="1"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>CONCLUSIONS, LIMITATIONS &amp; FUTURE WORK</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="56" name="TextBox 55"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{DC154571-5207-46E5-81CC-A8B7B4DEFFA2}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="1347067" y="39179688" /><a:ext cx="13525500" cy="3383280" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:spPr><p:txBody><a:bodyPr wrap="square" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:spAutoFit /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>FINDINGS</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>- The participation gate removes selected-but-silent APs; FIM clusters are physically defensible.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>- In this six-AP study, Nreq=4 is minimum-power and robust CSI is necessary.</a:t></a:r></a:p><a:p xmlns:a="http://