ngml/2006/main"><a:avLst /></a:prstGeom></p:spPr></p:pic><p:pic><p:nvPicPr><p:cNvPr id="86" name="Picture 30" /><p:cNvPicPr><a:picLocks noChangeAspect="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvPicPr><p:nvPr /></p:nvPicPr><p:blipFill><a:blip r:embed="R60439dcdfb3b4ba2" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:srcRect l="0" t="0" r="0" b="0" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:stretch xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:fillRect l="0" t="0" r="0" b="0" /></a:stretch></p:blipFill><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="3705225" y="30337125" /><a:ext cx="22860000" cy="6772275" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom></p:spPr></p:pic><p:sp><p:nvSpPr><p:cNvPr id="38" name="TextBox 37"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{2BFF4D1D-1058-4A03-AC3E-40AE603D4CAA}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="1194669" y="10718344" /><a:ext cx="19048660" cy="3714750" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:spPr><p:txBody><a:bodyPr wrap="square" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:spAutoFit /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>- 6G applications need simultaneous communication and high-precision sensing. Cell-free massive MIMO ISAC avoids duplicated spectrum, but imperfect CSI and non-convex resource allocation hinder deployment.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>- Gap: a nearest/path-loss AP cluster can contain APs with zero dedicated sensing power, so nominal selection is not physically meaningful participation.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>- Aim: minimise total transmit power while meeting robust communication SINR, sensing SINR and position-PCRB tracking constraints.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>- Thesis claim: AP-target participation must be optimised jointly with robust beamforming to obtain physically feasible, energy-efficient sensing clusters.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>- Evidence is reported only after fixed-topology re-optimisation and explicit feasibility validation.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="40" name="TextBox 39"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{66DD3917-8CB5-4789-864D-F6FE5EDB628A}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="1270092" y="16619828" /><a:ext cx="12608212" cy="2651760" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:spPr><p:txBody><a:bodyPr wrap="square" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:spAutoFit /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>1. Optimise AP-target participation and robust transmit covariances jointly.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>2. Tested system: M=6 APs, Nt=2 antennas/AP, K=3 UEs, P=2 targets, 400 m x 400 m.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>3. Each target selects exactly Nreq APs through b_mp in {0,1}.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>4. The sensing-power gate forces every selected AP to radiate nonzero dedicated sensing power.</a:t></a:r></a:p><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:pPr><a:buNone /></a:pPr><a:r><a:rPr sz="2400"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>5. Communication remains globally cooperative; only dedicated sensing is participation-gated.</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="42" name="TextBox 41"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{0AEA5035-594B-403D-8780-88838A44F046}" xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" /></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:cNvSpPr><p:nvPr /></p:nvSpPr><p:spPr><a:xfrm xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:off x="1270090" y="20940568" /><a:ext cx="12008089" cy="553998" /></a:xfrm><a:prstGeom prst="rect" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:avLst /></a:prstGeom><a:noFill xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /></p:spPr><p:txBody><a:bodyPr wrap="square" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:spAutoFit /></a:bodyPr><a:lstStyle xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" /><a:p xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:r><a:rPr sz="3000" i="1"><a:latin typeface="Arial" /><a:ea typeface="Arial" /><a:cs typeface="Arial" /></a:rPr><a:t>HOW TO READ THE SIX RESULT PANELS</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="43" name="TextBox 42"><a:extLst xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId id="{248D57D3-8807-4183-ACB8-B18D64119D32}" xmlns:a