@article{dongSensingService6G2023,
  title = {Sensing as a Service in {{6G}} Perceptive Networks: {{A}} Unified Framework for {{ISAC}} Resource Allocation},
  shorttitle = {Sensing as a {{Service}} in {{6G Perceptive Networks}}},
  author = {Dong, Fuwang and Liu, Fan and Cui, Yuanhao and Wang, Wei and Han, Kaifeng and Wang, Zhiqin},
  date = {2023-05},
  journaltitle = {IEEE Transactions on Wireless Communications},
  shortjournal = {IEEE Trans. Wireless Commun.},
  volume = {22},
  number = {5},
  pages = {3522--3536},
  issn = {1536-1276, 1558-2248},
  doi = {10.1109/TWC.2022.3219463},
  url = {https://ieeexplore.ieee.org/document/9945983/},
  urldate = {2025-09-18},
  abstract = {In the upcoming next-generation (5G-Advanced and 6G) wireless networks, sensing as a service will play a more important role than ever before. Recently, the concept of perceptive network is proposed as a paradigm shift that provides sensing and communication (S\&C) services simultaneously. This type of technology is typically referred to as Integrated Sensing and Communications (ISAC). In this paper, we propose the concept of sensing quality of service (QoS) in terms of diverse applications. Specifically, the probability of detection, the Crámer-Rao bound (CRB) for parameter estimation and the posterior CRB for moving target indication are employed to measure the sensing QoS for detection, localization, and tracking, respectively. Then, we establish a unified framework for ISAC resource allocation, where the fairness and the comprehensiveness optimization criteria are considered for the aforementioned sensing services. The proposed schemes can flexibly allocate the limited power and bandwidth resources according to both S\&C QoSs. Finally, we study the performance trade-off between S\&C services in different resource allocation schemes by numerical simulations.},
  langid = {english},
  keywords = {/unread,notion},
  annotation = {JCR分区: Q1\\
中科院分区升级版: 计算机科学1区\\
影响因子: 10.7\\
5年影响因子: 11.4\\
EI: 是\\
南京大学: B\\
TLDR: This paper proposes the concept of sensing quality of service (QoS) in terms of diverse applications and establishes a unified framework for ISAC resource allocation, where the fairness and the comprehensiveness optimization criteria are considered for the aforementioned sensing services.},
  file = {C\:\\Users\\yxp02\\Zotero\\storage\\3UDVKB6A\\Dong 等 - 2023 - Sensing as a Service in 6G Perceptive Networks A Unified Framework for ISAC Resource Allocation.no_watermark.zh-CN.mono.pdf;C\:\\Users\\yxp02\\Zotero\\storage\\66BVJWM3\\Dong 等 - 2023 - Sensing as a Service in 6G Perceptive Networks A Unified Framework for ISAC Resource Allocation.no_watermark.zh-CN.dual.pdf;C\:\\Users\\yxp02\\Zotero\\storage\\6LDZIAV5\\Dong 等 - 2023 - Sensing as a Service in 6G Perceptive Networks A Unified Framework for ISAC Resource Allocation.pdf;C\:\\Users\\yxp02\\Zotero\\storage\\IYBAEGMQ\\6G通感网络的资源分配解析.md}
}

@article{femeniasScalableCellfreeMassive2025,
  title = {Scalable Cell-Free Massive {{MIMO-based}} Integrated Sensing and Communication},
  author = {Femenias, Guillem and Riera-Palou, Felip},
  date = {2025},
  journaltitle = {IEEE Transactions on Vehicular Technology},
  shortjournal = {IEEE Trans. Veh. Technol.},
  pages = {1--16},
  issn = {0018-9545, 1939-9359},
  doi = {10.1109/TVT.2025.3566710},
  url = {https://ieeexplore.ieee.org/document/10982445/},
  urldate = {2025-10-08},
  abstract = {The advent of sixth-generation (6G) wireless communication networks heralds a new era of connectivity, with cellfree massive multiple-input multiple-output (CF-mMIMO) networks and integrated sensing and communication (ISAC) systems poised to play a major role. While promising numerous applications, the synergy between CF-mMIMO and ISAC technologies remains underexplored, particularly regarding scalability issues. This paper addresses this research gap by proposing a scalable CF-mMIMO-based ISAC framework integrating downlink (DL) payload data and sensing precoding schemes and fractional power allocation strategies. Building upon the non-scalable maximum a posteriori ratio test (MAPRT), our contributions also include the design of scalable partial MAPRT (P-MAPRT) and improved partial MAPRT (IP-MAPRT) target detectors, which consider both clutter and statistical radar cross-section information. Numerical results demonstrate that the proposed scalable detection schemes achieve competitive performance metrics compared to the non-scalable MAPRT, with notable trade-offs between detection probability and spectral efficiency per user. Our findings underscore the importance of designing reliable clutter-aware scalable target detection algorithms in CFmMIMO-based ISAC scenarios and provide insights into the process of selecting appropriate system parameters for balanced QoS metrics.},
  langid = {english},
  annotation = {JCR分区: Q1\\
中科院分区升级版: 计算机科学2区\\
影响因子: 7.1\\
5年影响因子: 7.4\\
EI: 是\\
南京大学: B\\
TLDR: A scalable CF-mMIMO-based ISAC framework integrating downlink payload data and sensing precoding schemes and fractional power allocation strategies is proposed, which includes the design of scalable partial MAPRT (P-MAPRT) and improved partial MAPRT (IP-MAPRT) target detectors.},
  file = {C\:\\Users\\yxp02\\Zotero\\storage\\CZ5V5V5V\\Femenias和Riera-Palou - 2025 - Scalable cell-free massive MIMO-based integrated sensing and communication.pdf;C\:\\Users\\yxp02\\Zotero\\storage\\MJAI4J3R\\Femenias和Riera-Palou - 2025 - Scalable cell-free massive MIMO-based integrated sensing and communication.no_watermark.zh-CN.dual.pdf;C\:\\Users\\yxp02\\Zotero\\storage\\VTAX37QJ\\Femenias和Riera-Palou - 2025 - Scalable cell-free massive MIMO-based integrated sensing and communication.no_watermark.zh-CN.mono.pdf}
