@online{matricardiMultitargetAcquisitionMultistatic2025,
  title = {Multi-Target Acquisition in Multistatic {{MIMO-OFDM}} Joint Sensing and Communication},
  author = {Matricardi, Elisabetta and Pucci, Lorenzo and Favarelli, Elia and Paolini, Enrico and Giorgetti, Andrea},
