@online{stylianopoulosDistributedIntelligentSensing2025,
  title = {Distributed Intelligent Sensing and Communications for {{6G}}: {{Architecture}} and Use Cases},
  shorttitle = {Distributed Intelligent Sensing and Communications for {{6G}}},
